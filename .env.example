# 値はコミットしない。実値は .env（gitignore済み）か GitHub Secrets に入れる。
RAKUTEN_APP_ID=your_application_id       # Rakuten Developers の Application ID（UUID）
RAKUTEN_ACCESS_KEY=pk_...                 # Rakuten Developers の Access Key（機密）
RAKUTEN_AFFILIATE_ID=your_affiliate_id   # アフィリエイトID（xxxxxxxx.xxxxxxxx.xxxxxxxx.xxxxxxxx）
ANTHROPIC_API_KEY=sk-ant-...

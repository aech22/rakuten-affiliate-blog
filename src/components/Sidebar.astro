---
import { getCollection } from 'astro:content';
import { CATEGORIES } from '../data/taxonomy';
import ShiftyPromo from './ShiftyPromo.astro';
const recent = (await getCollection('articles'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 6);

// A8.net フラットクリーニング（宅配クリーニング）テキストリンク。daily / interior の読者→家事の外注の文脈。
// 規約どおり原文のまま。& のJSXパース回避で set:html。picknavi で最初の A8 広告枠（2026-09-05）。
const flatCleaningHtml = `<a href="https://px.a8.net/svt/ejp?a8mat=4BC3YU+3O692Q+4R18+61Z82" rel="nofollow sponsored" target="_blank" class="font-bold text-brand-600 hover:underline">自宅で完結！宅配クリーニングはフラットクリーニング</a><img border="0" width="1" height="1" src="https://www13.a8.net/0.gif?a8mat=4BC3YU+3O692Q+4R18+61Z82" alt="">`;

// A8.net シャークニンジャ（掃除機・キッチン家電の公式ストア）テキストリンク。daily / kitchen の読者の文脈。
const sharkNinjaHtml = `<a href="https://px.a8.net/svt/ejp?a8mat=4BC3YU+48EZN6+4S6M+5YJRM" rel="nofollow sponsored" target="_blank" class="font-bold text-brand-600 hover:underline">日本の暮らしを考えてデザインした掃除機【Shark(シャーク)】</a><img border="0" width="1" height="1" src="https://www15.a8.net/0.gif?a8mat=4BC3YU+48EZN6+4S6M+5YJRM" alt="">`;
---
<aside class="space-y-6">
  <section class="rounded-2xl border border-black/5 bg-white p-5">
    <h2 class="mb-3 flex items-center gap-2 text-sm font-black"><span class="h-4 w-1.5 rounded bg-brand-500" />カテゴリ</h2>
    <ul class="space-y-1">
      {CATEGORIES.map((c) => (
        <li>
          <a href={`${import.meta.env.BASE_URL}categories/${c.slug}/`} class="flex items-center gap-2 rounded-lg px-2 py-1.5 text-sm text-ink/70 transition hover:bg-brand-50 hover:text-brand-600">
            <span>{c.emoji}</span>{c.label}
          </a>
        </li>
      ))}
    </ul>
  </section>
  {recent.length > 0 && (
    <section class="rounded-2xl border border-black/5 bg-white p-5">
      <h2 class="mb-3 flex items-center gap-2 text-sm font-black"><span class="h-4 w-1.5 rounded bg-brand-500" />新着記事</h2>
      <ul class="space-y-3">
        {recent.map((a) => (
          <li>
            <a href={`${import.meta.env.BASE_URL}articles/${a.id}/`} class="block text-sm font-medium leading-snug text-ink/80 transition hover:text-brand-600">{a.data.title}</a>
          </li>
        ))}
      </ul>
    </section>
  )}
  <section class="rounded-2xl border border-black/5 bg-white p-4">
    <p class="mb-2 text-[11px] font-black tracking-wide text-ink/35">広告 · 家事の手間を減らす</p>
    <p class="mb-2 text-xs leading-relaxed text-ink/60">道具を選ぶのと同じくらい、手間そのものを外に出す選択肢もあります。衣類は宅配クリーニング、掃除は公式ストアの保証つきで揃える手があります。</p>
    <p class="mb-3 text-sm leading-snug" set:html={flatCleaningHtml} />
    <p class="text-sm leading-snug" set:html={sharkNinjaHtml} />
  </section>

  <ShiftyPromo variant="sidebar" />

</aside>

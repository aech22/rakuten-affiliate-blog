---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  ogImage?: string;
}
const {
  title,
  description = '実際に楽天で売れている商品を、写真・価格・レビューと一緒に比較するおすすめ紹介ブログ。',
  noindex = false,
  ogImage,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImg = ogImage ? new URL(ogImage, Astro.site).toString() : undefined;
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700;900&display=swap"
      rel="stylesheet"
    />
    <!-- OGP -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="picknavi" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImg && <meta property="og:image" content={ogImg} />}
    <meta name="twitter:card" content={ogImg ? 'summary_large_image' : 'summary'} />
  </head>
  <body class="min-h-screen font-sans text-ink antialiased">
    <header class="sticky top-0 z-30 border-b border-black/5 bg-cream/85 backdrop-blur">
      <div class="mx-auto flex max-w-5xl items-center justify-between px-4 py-3">
        <a href="/" class="flex items-center gap-2">
          <span class="grid h-8 w-8 place-items-center rounded-lg bg-brand-500 font-black text-white shadow-sm">P</span>
          <span class="text-lg font-black tracking-tight">picknavi<span class="text-brand-500">.</span></span>
        </a>
        <a href="/" class="text-sm font-bold text-ink/55 hover:text-brand-600">記事一覧</a>
      </div>
    </header>

    <slot />

    <footer class="mt-20 border-t border-black/5 bg-white">
      <div class="mx-auto max-w-5xl px-4 py-8 text-sm text-ink/55">
        <p class="text-base font-black text-ink/75">picknavi<span class="text-brand-500">.</span></p>
        <p class="mt-1">楽天で実際に売れている商品を、写真とレビューをもとに比較して紹介しています。</p>
        <p class="mt-4 text-xs leading-relaxed text-ink/45">
          当サイトはアフィリエイト広告（楽天アフィリエイト等）を利用しています。掲載の価格・在庫・レビューは変動する場合があります。最新の情報は各商品ページをご確認ください。
        </p>
        <p class="mt-3 text-xs text-ink/35">© {year} picknavi</p>
      </div>
    </footer>
  </body>
</html>

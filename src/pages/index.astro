---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const articles = (await getCollection('articles')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---
<BaseLayout title="おすすめ比較ブログ｜商品レビュー・比較">
  <h1 class="mb-6 text-2xl font-bold">記事一覧</h1>
  {articles.length === 0 && <p class="text-gray-500">記事はまだありません。</p>}
  <ul class="space-y-4">
    {articles.map((a) => (
      <li class="border-b pb-4">
        <a href={`/articles/${a.id}/`} class="text-lg text-blue-600 underline">
          {a.data.title}
        </a>
        <p class="text-sm text-gray-500">{a.data.date.toISOString().slice(0, 10)}</p>
        {a.data.description && <p class="text-gray-700">{a.data.description}</p>}
      </li>
    ))}
  </ul>
</BaseLayout>

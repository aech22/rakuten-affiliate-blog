---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const articles = (await getCollection('articles')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const fmtDate = (d: Date) => d.toISOString().slice(0, 10).replace(/-/g, '.');
---
<BaseLayout title="picknavi｜写真とレビューで選ぶ おすすめ商品比較">
  <!-- ヒーロー -->
  <section class="bg-gradient-to-br from-brand-500 to-[#ff9a5a] text-white">
    <div class="mx-auto max-w-5xl px-4 py-14 sm:py-20">
      <p class="text-xs font-black tracking-[0.2em] text-white/80">PICK &amp; COMPARE</p>
      <h1 class="mt-3 text-3xl font-black leading-tight sm:text-4xl">
        迷ったら、<br class="sm:hidden" />売れているものから選ぶ。
      </h1>
      <p class="mt-4 max-w-xl leading-relaxed text-white/90">
        楽天で実際に売れている商品を、<b class="font-bold text-white">写真・価格・レビュー</b>と一緒に比較。あなたの「これでいい」を最短で見つけます。
      </p>
    </div>
  </section>

  <!-- 記事一覧 -->
  <main class="mx-auto max-w-5xl px-4 py-12">
    <h2 class="mb-6 flex items-center gap-2 text-xl font-black">
      <span class="h-5 w-1.5 rounded bg-brand-500"></span>新着の比較記事
    </h2>

    {articles.length === 0 && <p class="text-ink/50">記事はまだありません。</p>}

    <div class="grid gap-6 sm:grid-cols-2">
      {
        articles.map((a) => {
          const products = a.data.products ?? [];
          const thumb = products[0]?.image;
          return (
            <a
              href={`/articles/${a.id}/`}
              class="group flex flex-col overflow-hidden rounded-2xl border border-black/5 bg-white shadow-sm transition hover:-translate-y-1 hover:shadow-xl"
            >
              <div class="relative aspect-[16/9] overflow-hidden bg-brand-50">
                {thumb ? (
                  <img
                    src={thumb}
                    alt={a.data.title}
                    loading="lazy"
                    class="h-full w-full object-contain p-4 transition duration-300 group-hover:scale-105"
                  />
                ) : (
                  <div class="grid h-full place-items-center text-sm text-brand-500/40">no image</div>
                )}
                {a.data.category && (
                  <span class="absolute left-3 top-3 rounded-full bg-white/90 px-3 py-1 text-xs font-black text-brand-600 shadow-sm">
                    {a.data.category}
                  </span>
                )}
              </div>
              <div class="flex flex-1 flex-col p-5">
                <p class="text-xs font-bold text-ink/40">
                  {fmtDate(a.data.date)}・{products.length}商品を比較
                </p>
                <h3 class="mt-1 font-bold leading-snug transition group-hover:text-brand-600">
                  {a.data.title}
                </h3>
                {a.data.description && (
                  <p class="mt-2 line-clamp-2 text-sm leading-relaxed text-ink/60">{a.data.description}</p>
                )}
                <span class="mt-4 inline-flex items-center gap-1 text-sm font-black text-brand-600">
                  続きを読む <span class="transition group-hover:translate-x-1">→</span>
                </span>
              </div>
            </a>
          );
        })
      }
    </div>
  </main>
</BaseLayout>
